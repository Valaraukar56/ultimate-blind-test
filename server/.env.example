# --- Serveur ---
PORT=3001
NODE_ENV=development

# Frontend autorisé (CORS + Socket.io)
CLIENT_URL=http://localhost:5173

# --- Base de données PostgreSQL ---
DATABASE_URL="postgresql://user:password@localhost:5432/blindtest?schema=public"

# --- Deezer API ---
# Aucune clé requise pour les previews 30s
DEEZER_API_BASE=https://api.deezer.com

# --- Jeu ---
ROUNDS_PER_GAME=10
ROUND_DURATION_SEC=30
